# GPU Bringup Daily Status Tracker - Environment Configuration
# 复制此文件为 .env 并根据实际需求修改配置

# ============ 服务器配置 ============
# 服务器端口 (默认：3000)
PORT=3000

# 运行环境 (development/production)
NODE_ENV=production

# ============ 日志配置 ============
# 日志保留天数 (默认：30 天)
LOG_RETENTION_DAYS=30

# ============ 安全配置 ============
# Session 过期时间 (毫秒，默认：24 小时 = 86400000)
# SESSION_TIMEOUT=86400000

# ============ 默认用户密码 (首次启动时创建) ============
# 首次启动时用于创建 CHANGE_ME 和 user 账号的密码
# 如果不设置，系统会生成随机密码并打印到控制台
# DEFAULT_ADMIN_PASSWORD=YourStrongAdminPassword!
# DEFAULT_USER_PASSWORD=YourStrongUserPassword!

# ============ 备份配置 ============
# 是否启用自动备份 (默认：true)
# AUTO_BACKUP=true

# 备份保留数量 (默认：7)
# BACKUP_RETENTION=7

# ============ 项目与邮件配置 (2026-10-21 深度脱敏后新增) ============
# 自动总结/邮件日报的项目 id 列表 (逗号分隔; 真实项目 id 不入公开仓库)
# AUTO_SUMMARY_PROJECTS=your-project-id
# MAIL_REPORT_PROJECTS=your-project-id
# MAIL_SENDER=sender@example.com
# MAIL_REPORT_TIME=09:00
# Hardware 平台用户库端口 (统一登录回退; 默认 3002, 按实际部署改)
# HARDWARE_AUTH_PORT=3002
